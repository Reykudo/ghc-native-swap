cabal-version:      3.0
name:               hot-swap
version:            0.1.0.0
synopsis:           GC-aware hot swapping of Haskell native shared objects
description:
    Compiles versioned Haskell modules in a separate service and safely swaps
    their native shared objects inside one long-lived dynamic RTS.
    See docs/README.md.
category:           Development
tested-with:        GHC ==9.10.3
license:            NONE
build-type:         Simple
extra-source-files:
    README.md
    docs/*.md

common warnings
    default-language: GHC2021
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wredundant-constraints

library
    import:          warnings
    hs-source-dirs:  src
    exposed-modules:
        HotSwap
        HotSwap.Plugin
        HotSwap.Polling
    other-modules:
        HotSwap.Error
        HotSwap.Internal.ABI
        HotSwap.Internal.Native
    build-depends:
        base >=4.20 && <4.21,
        deepseq >=1.5 && <1.6,
        directory >=1.3 && <1.4,
        ghci >=9.10 && <9.11,
        stm >=2.5 && <2.6

library compiler
    import:          warnings
    visibility:      public
    hs-source-dirs:  src-compiler
    exposed-modules:
        HotSwap.Compiler
        HotSwap.Compiler.Client
        HotSwap.Compiler.Protocol
        HotSwap.Compiler.Server
    build-depends:
        aeson >=2.2 && <2.3,
        base >=4.20 && <4.21,
        bytestring >=0.12 && <0.13,
        containers >=0.7 && <0.8,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hot-swap,
        http-client >=0.7 && <0.8,
        http-types >=0.12 && <0.13,
        process >=1.6 && <1.7,
        stm >=2.5 && <2.6,
        text >=2.1 && <2.2,
        time >=1.12 && <1.13,
        wai >=3.2 && <3.3,
        warp >=3.4 && <3.5

executable hot-swap-compiler
    import:          warnings
    hs-source-dirs:  app/compiler
    main-is:         Main.hs
    ghc-options:     -threaded -rtsopts -with-rtsopts=-N
    build-depends:
        base >=4.20 && <4.21,
        hot-swap:compiler,
        text >=2.1 && <2.2,
        warp >=3.4 && <3.5

test-suite hot-swap-test
    import:          warnings
    type:            exitcode-stdio-1.0
    hs-source-dirs:  test
    main-is:         Main.hs
    other-modules:
        Test.Compiler
        Test.NativeChild
        Test.Runtime
        Test.Support
    ghc-options:
        -dynamic
        -threaded
        -rtsopts
        -with-rtsopts=-N2
    build-depends:
        aeson >=2.2 && <2.3,
        base >=4.20 && <4.21,
        bytestring >=0.12 && <0.13,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        hot-swap,
        hot-swap:compiler,
        http-client >=0.7 && <0.8,
        http-types >=0.12 && <0.13,
        process >=1.6 && <1.7,
        stm >=2.5 && <2.6,
        tasty >=1.5 && <1.6,
        tasty-hunit >=0.10 && <0.11,
        text >=2.1 && <2.2,
        warp >=3.4 && <3.5
