cabal-version:      3.0
name:               ghc-native-swap
version:            0.1.0.0
synopsis:           GC-aware hot swapping of Haskell native shared objects
description:
  Compiles versioned Haskell modules in a separate service and safely swaps
  their native shared objects inside one long-lived dynamic RTS.
  See docs/README.md.

category:           Development
tested-with:        GHC ==9.10.3
license:
build-type:         Simple
extra-source-files:
  docs/*.md
  README.md

common warnings
  default-language: GHC2021
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints

library unload-safety
  import:          warnings
  visibility:      public
  hs-source-dirs:  src-safety
  exposed-modules:
    GHC.NativeSwap.UnloadSafe

  build-depends:
    , base        >=4.20 && <4.21
    , containers  >=0.7  && <0.8
    , deepseq     >=1.5  && <1.6
    , vector      >=0.13 && <0.14

library
  import:          warnings
  hs-source-dirs:  src
  exposed-modules:
    GHC.NativeSwap
    GHC.NativeSwap.Plugin
    GHC.NativeSwap.Polling

  other-modules:
    GHC.NativeSwap.Error
    GHC.NativeSwap.Internal.ABI
    GHC.NativeSwap.Internal.Native

  build-depends:
    , base       >=4.20 && <4.21
    , deepseq    >=1.5  && <1.6
    , directory  >=1.3  && <1.4
    , ghc-native-swap:unload-safety
    , ghci       >=9.10 && <9.11
    , stm        >=2.5  && <2.6

library compiler
  import:          warnings
  visibility:      public
  hs-source-dirs:  src-compiler
  exposed-modules:
    GHC.NativeSwap.Compiler
    GHC.NativeSwap.Compiler.Client
    GHC.NativeSwap.Compiler.Protocol
    GHC.NativeSwap.Compiler.Server

  build-depends:
    , aeson            >=2.2  && <2.3
    , base             >=4.20 && <4.21
    , bytestring       >=0.12 && <0.13
    , containers       >=0.7  && <0.8
    , directory        >=1.3  && <1.4
    , filepath         >=1.5  && <1.6
    , ghc-native-swap
    , http-client      >=0.7  && <0.8
    , http-types       >=0.12 && <0.13
    , process          >=1.6  && <1.7
    , stm              >=2.5  && <2.6
    , text             >=2.1  && <2.2
    , time             >=1.12 && <1.13
    , wai              >=3.2  && <3.3
    , warp             >=3.4  && <3.5

executable ghc-native-swap-compiler
  import:         warnings
  hs-source-dirs: app/compiler
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base                      >=4.20 && <4.21
    , ghc-native-swap:compiler
    , text                      >=2.1  && <2.2
    , warp                      >=3.4  && <3.5

test-suite ghc-native-swap-test
  import:         warnings
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  other-modules:
    Test.Compiler
    Test.NativeChild
    Test.Runtime
    Test.Support

  ghc-options:    -dynamic -threaded -rtsopts -with-rtsopts=-N2
  build-depends:
    , aeson                     >=2.2  && <2.3
    , base                      >=4.20 && <4.21
    , bytestring                >=0.12 && <0.13
    , directory                 >=1.3  && <1.4
    , filepath                  >=1.5  && <1.6
    , ghc-native-swap
    , ghc-native-swap:compiler
    , http-client               >=0.7  && <0.8
    , http-types                >=0.12 && <0.13
    , process                   >=1.6  && <1.7
    , stm                       >=2.5  && <2.6
    , tasty                     >=1.5  && <1.6
    , tasty-hunit               >=0.10 && <0.11
    , text                      >=2.1  && <2.2
    , warp                      >=3.4  && <3.5
